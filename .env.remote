# Deployment configuration
# Copy this file to .env.remote.local and fill in values.
REMOTE_USER=""
REMOTE_HOST=""
REMOTE_PORT="22"
REMOTE_PATH=""
DOCKER_IMAGE=""
KUBE_CONFIG=""
K8S_NAMESPACE="default"
K8S_DEPLOYMENT="artifact-keeper"
K8S_WAIT_TIMEOUT="300"
GIT_SHA=""
APP_VERSION=""
CARGO_FEATURES=""
